---
import componentsRaw from '../scripts/components.jsx?raw';
import photosRaw     from '../scripts/photos.jsx?raw';
import coffeeRaw     from '../scripts/coffee.jsx?raw';
import dataRaw       from '../scripts/data.jsx?raw';
import appRaw        from '../scripts/app.jsx?raw';
import dashboardRaw  from '../scripts/dashboard.jsx?raw';
import newBedRaw     from '../scripts/new-bed.jsx?raw';

const isProd = import.meta.env.PROD;
const reactSrc    = isProd
  ? 'https://unpkg.com/react@18.3.1/umd/react.production.min.js'
  : 'https://unpkg.com/react@18.3.1/umd/react.development.js';
const reactDomSrc = isProd
  ? 'https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js'
  : 'https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>The Garden — a quiet record</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..700,30..100,0..1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --paper: #fbf6f1;
    --paper-warm: #f5ece2;
    --paper-deep: #efe3d4;
    --ink: #3d2c33;
    --ink-soft: #8a7079;
    --rule: #e8d9cf;
    --accent-soft: #f9e3e6;
    --accent: #f1c3c9;
    --accent-strong: #d97a87;
    --sage: #b6c2a3;
    --sage-strong: #6f8758;
    --butter: #ecd5a0;
    --chip-rose-bg: #fae6e9;
    --chip-rose-ink: #b8525e;
    --chip-rose-border: #f0c8cd;
    --font-display: 'Fraunces', Georgia, serif;
    --font-ui: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;

    --pad-main: 40px 56px 80px;
    --max-main: 1180px;
  }

  html, body {
    margin: 0; padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(217, 122, 135, 0.04) 0, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(182, 194, 163, 0.04) 0, transparent 40%);
    pointer-events: none; z-index: 0;
  }

  * { box-sizing: border-box; }
  button { font: inherit; }
  input, textarea { font: inherit; color: var(--ink); }
  input::placeholder, textarea::placeholder { color: var(--ink-soft); opacity: 0.7; }

  input[type=range] { -webkit-appearance: none; appearance: none; background: transparent; height: 18px; }
  input[type=range]::-webkit-slider-runnable-track { height: 4px; background: var(--accent-soft); border-radius: 999px; }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 16px; height: 16px; margin-top: -6px;
    background: var(--paper); border: 2px solid var(--accent-strong);
    border-radius: 50%; cursor: pointer;
    box-shadow: 0 2px 6px -1px rgba(217, 122, 135, 0.4);
  }
  input[type=range]::-moz-range-track { height: 4px; background: var(--accent-soft); border-radius: 999px; }
  input[type=range]::-moz-range-thumb { width: 14px; height: 14px; background: var(--paper); border: 2px solid var(--accent-strong); border-radius: 50%; cursor: pointer; }

  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 999px; border: 2px solid var(--paper); }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .menu-btn {
    display: none;
    position: fixed; top: 14px; left: 14px; z-index: 60;
    width: 42px; height: 42px; border-radius: 12px;
    background: var(--paper); border: 1px solid var(--rule);
    cursor: pointer; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px -4px rgba(60, 40, 50, 0.2);
  }
  .menu-btn span {
    display: block; width: 18px; height: 1.6px; background: var(--ink);
    position: relative;
  }
  .menu-btn span::before, .menu-btn span::after {
    content: ''; position: absolute; left: 0; width: 18px; height: 1.6px; background: var(--ink);
  }
  .menu-btn span::before { top: -6px; }
  .menu-btn span::after { top: 6px; }

  .scrim {
    display: none;
    position: fixed; inset: 0; z-index: 40;
    background: rgba(60, 40, 50, 0.4);
    backdrop-filter: blur(4px);
    animation: fadeIn 200ms ease;
  }

  @media (max-width: 880px) {
    :root { --pad-main: 80px 18px 60px; }
    .menu-btn { display: flex; }
    .sidebar {
      position: fixed !important;
      top: 0; left: 0; bottom: 0;
      transform: translateX(-100%);
      transition: transform 220ms cubic-bezier(0.2, 0.9, 0.3, 1);
      z-index: 50;
      box-shadow: 0 0 40px -10px rgba(60, 40, 50, 0.3);
    }
    .sidebar.open { transform: translateX(0); }
    .scrim.open { display: block; }
    .grid-stat { grid-template-columns: repeat(2, 1fr) !important; }
    .grid-cats, .grid-tops { grid-template-columns: 1fr !important; }
    .greeting-h1 { font-size: 36px !important; }
    .browse-h1, .dash-h1 { font-size: 32px !important; }
    .detail-modal { max-height: 92vh !important; }
    .detail-header-row { flex-direction: column !important; align-items: flex-start !important; gap: 16px !important; }
    .add-sheet { max-width: 100% !important; }
    .toolbar-row { flex-wrap: wrap; }
    .feed-row {
      grid-template-columns: 56px 1fr auto !important;
      gap: 12px !important;
    }
    .score-table-row {
      grid-template-columns: 1.2fr 1fr 1fr 1fr !important;
      padding: 10px 12px !important;
    }
    .pad-detail { padding: 22px !important; }
  }

  @media (max-width: 480px) {
    .grid-stat { grid-template-columns: 1fr !important; }
    .greeting-h1 { font-size: 30px !important; }
    .browse-h1, .dash-h1 { font-size: 26px !important; }
    .add-sheet-grid-2 { grid-template-columns: 1fr !important; }
    .rater-grid { grid-template-columns: 1fr !important; }
    .cat-grid-3 { grid-template-columns: 1fr 1fr !important; }
  }
</style>
</head>

<body>
<div id="root" style="position: relative; z-index: 1;"></div>

<script src={reactSrc} crossorigin="anonymous"></script>
<script src={reactDomSrc} crossorigin="anonymous"></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" crossorigin="anonymous"></script>

<Fragment set:html={`<script type="text/babel">${componentsRaw}</script>`} />
<Fragment set:html={`<script type="text/babel">${photosRaw}</script>`} />
<Fragment set:html={`<script type="text/babel">${coffeeRaw}</script>`} />
<Fragment set:html={`<script type="text/babel">${dataRaw}</script>`} />
<Fragment set:html={`<script type="text/babel">${appRaw}</script>`} />
<Fragment set:html={`<script type="text/babel">${dashboardRaw}</script>`} />
<Fragment set:html={`<script type="text/babel">${newBedRaw}</script>`} />

<script type="text/babel">
  const { useState, useEffect } = React;

  const LoadingScreen = () => (
    <div style={{
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      height: '100vh', background: 'var(--paper)',
    }}>
      <div style={{ textAlign: 'center' }}>
        <PetalMark size={36} color="var(--accent-strong)" />
        <div style={{
          fontFamily: 'var(--font-display)', fontSize: 16, fontStyle: 'italic',
          color: 'var(--ink-soft)', marginTop: 14,
        }}>growing…</div>
      </div>
    </div>
  );

  const LoginModal = ({ onLogin, onClose, error }) => {
    const [pw, setPw] = useState('');
    const [busy, setBusy] = useState(false);
    const submit = async (e) => {
      e.preventDefault();
      setBusy(true);
      await onLogin(pw);
      setBusy(false);
    };
    return (
      <div onClick={onClose} style={{
        position: 'fixed', inset: 0, zIndex: 200,
        background: 'rgba(60,40,50,0.36)', backdropFilter: 'blur(6px)',
        display: 'grid', placeItems: 'center', padding: 32,
      }}>
        <div onClick={(e) => e.stopPropagation()} style={{
          background: 'var(--paper)', borderRadius: 22, padding: 32,
          maxWidth: 360, width: '100%',
          border: '1px solid var(--rule)',
          boxShadow: '0 24px 60px -20px rgba(60,40,50,0.4)',
        }}>
          <div style={{
            fontFamily: 'var(--font-display)', fontSize: 26, fontWeight: 500,
            color: 'var(--ink)', marginBottom: 6, letterSpacing: -0.4,
          }}>welcome back.</div>
          <p style={{
            fontFamily: 'var(--font-display)', fontStyle: 'italic',
            fontSize: 14.5, color: 'var(--ink-soft)', margin: '0 0 22px',
          }}>enter your password to tend the garden.</p>
          <form onSubmit={submit}>
            <input
              type="password" value={pw}
              onChange={(e) => setPw(e.target.value)}
              placeholder="password"
              autoFocus
              style={{
                width: '100%', padding: '10px 14px', borderRadius: 10,
                border: '1px solid var(--rule)', background: 'var(--paper-warm)',
                fontFamily: 'var(--font-ui)', fontSize: 14, color: 'var(--ink)',
                outline: 'none', boxSizing: 'border-box', marginBottom: error ? 8 : 14,
              }}
            />
            {error && (
              <div style={{
                fontFamily: 'var(--font-ui)', fontSize: 12.5,
                color: '#c0392b', marginBottom: 12,
              }}>{error}</div>
            )}
            <button type="submit" disabled={busy || !pw} style={{
              width: '100%', padding: '11px 0', borderRadius: 10,
              background: 'var(--accent-strong)', border: 'none',
              cursor: busy ? 'default' : 'pointer',
              fontFamily: 'var(--font-ui)', fontSize: 14, fontWeight: 500,
              color: 'var(--paper)', opacity: busy ? 0.7 : 1,
            }}>
              {busy ? 'entering…' : 'enter the garden'}
            </button>
          </form>
        </div>
      </div>
    );
  };

  function App() {
    const [loading, setLoading]       = useState(true);
    const [canEdit, setCanEdit]       = useState(false);
    const [weights, setWeights]       = useState(DEFAULT_WEIGHTS);
    const [view, setView]             = useState({ name: 'home' });
    const [detail, setDetail]         = useState(null);
    const [adding, setAdding]         = useState(false);
    const [editing, setEditing]       = useState(null);
    const [addingBed, setAddingBed]   = useState(false);
    const [navOpen, setNavOpen]       = useState(false);
    const [bump, setBump]             = useState(0);
    const [loginOpen, setLoginOpen]   = useState(false);
    const [loginError, setLoginError] = useState('');

    useEffect(() => {
      Promise.all([
        hydrate(),
        fetch('/api/settings')
          .then((r) => r.ok ? r.json() : null)
          .then((w) => { if (w) setWeights(w); })
          .catch(() => {}),
        fetch('/api/auth/me')
          .then((r) => r.ok ? r.json() : null)
          .then((a) => { if (a?.authenticated) setCanEdit(true); })
          .catch(() => {}),
      ]).then(() => setLoading(false));
    }, []);

    const handleLogin = async (password) => {
      try {
        const r = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        if (r.ok) {
          setCanEdit(true);
          setLoginOpen(false);
          setLoginError('');
        } else {
          setLoginError('Wrong password. Try again.');
        }
      } catch {
        setLoginError('Login failed — check your connection.');
      }
    };

    const handleLogout = async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      setCanEdit(false);
    };

    if (loading) return <LoadingScreen />;

    const counts = Object.fromEntries(
      CATEGORIES.map((c) => [c.id, (ALL_DATA[c.id] || []).length])
    );

    const openDetail = (cat, id) => {
      if (id) setDetail({ cat, id });
      else { setView({ name: 'browse', cat }); setNavOpen(false); }
    };
    const openAdd = (cat) => setAdding({ cat: cat || view.cat });

    const handleEdit = (catId, id) => {
      setDetail(null);
      setEditing({ cat: catId, id });
    };

    const handleDelete = async (catId, id) => {
      await deleteEntry(catId, id);
      deletePhoto(id);
      setDetail(null);
      setBump((b) => b + 1);
    };

    const goView = (v) => { setView(v); setDetail(null); setNavOpen(false); };

    return (
      <div style={{ display: 'flex', minHeight: '100vh' }} data-screen-label="App">
        <button className="menu-btn" onClick={() => setNavOpen(true)} aria-label="Open menu">
          <span></span>
        </button>
        <div className={`scrim ${navOpen ? 'open' : ''}`} onClick={() => setNavOpen(false)} />
        <Sidebar view={view} setView={goView} counts={counts} navOpen={navOpen} onNewBed={() => setAddingBed(true)} canEdit={canEdit} onLogout={handleLogout} />

        <main style={{
          flex: 1, padding: 'var(--pad-main)', maxWidth: 'var(--max-main)',
          margin: '0 auto', width: '100%',
        }} data-screen-label={view.name}>
          {view.name === 'home'      && <HomeView      weights={weights} onOpen={openDetail} onAdd={openAdd} bump={bump} canEdit={canEdit} />}
          {view.name === 'dashboard' && <DashboardView weights={weights} onOpen={openDetail} bump={bump} />}
          {view.name === 'browse'    && <BrowseView    catId={view.cat} weights={weights} onOpen={openDetail} onAdd={openAdd} bump={bump} canEdit={canEdit} />}
        </main>

        {detail && (
          <DetailView
            catId={detail.cat} itemId={detail.id} weights={weights}
            onClose={() => setDetail(null)}
            onEdit={handleEdit}
            onDelete={handleDelete}
            canEdit={canEdit}
          />
        )}
        {canEdit && adding && (
          <AddSheet
            initialCat={adding.cat} weights={weights}
            onClose={() => setAdding(false)}
            onSaved={() => setBump((b) => b + 1)}
          />
        )}
        {canEdit && editing && (() => {
          const item = (ALL_DATA[editing.cat] || []).find((i) => i.id === editing.id);
          return item ? (
            <AddSheet
              editCatId={editing.cat} editItem={item} weights={weights}
              onClose={() => setEditing(null)}
              onSaved={() => setBump((b) => b + 1)}
            />
          ) : null;
        })()}
        {canEdit && addingBed && (
          <NewBedModal
            onClose={() => setAddingBed(false)}
            onCreated={(id) => { setBump((b) => b + 1); setView({ name: 'browse', cat: id }); }}
          />
        )}

        {canEdit ? (
          <button
            onClick={() => openAdd(view.name === 'browse' ? view.cat : undefined)}
            aria-label="Add new entry"
            style={{
              position: 'fixed', bottom: 32, right: 32, zIndex: 89,
              width: 56, height: 56, borderRadius: '50%',
              background: 'var(--accent-strong)', border: 'none', cursor: 'pointer',
              display: 'grid', placeItems: 'center',
              boxShadow: '0 8px 24px -8px rgba(217, 122, 135, 0.65)',
              color: 'var(--paper)',
            }}
          >
            <span style={{ fontSize: 28, lineHeight: 1, display: 'block', marginTop: -2 }}>+</span>
          </button>
        ) : (
          <button
            onClick={() => { setLoginError(''); setLoginOpen(true); }}
            style={{
              position: 'fixed', bottom: 32, right: 32, zIndex: 89,
              padding: '10px 18px', borderRadius: 999,
              background: 'var(--paper)', border: '1px solid var(--rule)',
              cursor: 'pointer', fontFamily: 'var(--font-mono)', fontSize: 11,
              letterSpacing: 1.4, textTransform: 'uppercase', color: 'var(--ink-soft)',
              boxShadow: '0 4px 12px -4px rgba(60,40,50,0.15)',
            }}
          >login</button>
        )}

        {loginOpen && (
          <LoginModal
            onLogin={handleLogin}
            onClose={() => { setLoginOpen(false); setLoginError(''); }}
            error={loginError}
          />
        )}
      </div>
    );
  }

  ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body>
</html>
